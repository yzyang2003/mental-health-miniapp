.profile-page {
  min-height: 100vh;
  padding: 128rpx var(--space-page-x) 180rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4fbf7 0%, #eef7f3 52%, #f8f4ee 100%);
}

.profile-card {
  margin-bottom: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.85);
  box-shadow: 0 12rpx 30rpx rgba(61, 90, 74, 0.08);
}

.profile-overview {
  background: linear-gradient(135deg, #6eaa8a, #82b79a);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.section-title {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #2b4a3d;
}

.section-subtitle {
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b8578;
}

.overview-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.overview-avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 66rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.45);
}

.overview-main {
  flex: 1;
}

.overview-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.overview-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.92);
}

.overview-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quick-item {
  position: relative;
  overflow: hidden;
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  padding: 18rpx 16rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(239, 247, 242, 0.95);
  border: 1rpx solid rgba(198, 223, 210, 0.75);
  min-height: 168rpx;
}

.quick-item::after {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -60rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 62%);
  opacity: 0.9;
  pointer-events: none;
}

.quick-item-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.quick-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  color: #ffffff;
  background: rgba(110, 170, 138, 0.95);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  box-shadow: 0 10rpx 22rpx rgba(61, 90, 74, 0.12);
}

.quick-chevron {
  font-size: 44rpx;
  line-height: 1;
  color: rgba(43, 74, 61, 0.22);
  transform: translateY(-2rpx);
}

.quick-title {
  position: relative;
  z-index: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: #2b4a3d;
}

.quick-desc {
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b8578;
}

.quick-item.tone-mint {
  background: linear-gradient(145deg, rgba(236, 253, 245, 0.98), rgba(223, 244, 232, 0.92));
  border-color: rgba(167, 243, 208, 0.55);
}

.quick-item.tone-mint .quick-icon {
  background: linear-gradient(135deg, #22c55e, #16a34a);
}

.quick-item.tone-sage {
  background: linear-gradient(145deg, rgba(240, 253, 250, 0.98), rgba(224, 242, 232, 0.92));
  border-color: rgba(153, 209, 191, 0.55);
}

.quick-item.tone-sage .quick-icon {
  background: linear-gradient(135deg, #14b8a6, #0f766e);
}

.quick-item.tone-sky {
  background: linear-gradient(145deg, rgba(239, 246, 255, 0.98), rgba(224, 242, 254, 0.92));
  border-color: rgba(147, 197, 253, 0.55);
}

.quick-item.tone-sky .quick-icon {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
}

.quick-item.tone-teal {
  background: linear-gradient(145deg, rgba(236, 254, 255, 0.98), rgba(207, 250, 254, 0.92));
  border-color: rgba(103, 232, 249, 0.55);
}

.quick-item.tone-teal .quick-icon {
  background: linear-gradient(135deg, #06b6d4, #0891b2);
}

.toggle-card {
  padding: var(--space-card-padding);
}

.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.toggle-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #2b4a3d;
}

.toggle-icon {
  font-size: 24rpx;
  color: #6b8578;
}

.avatar-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--space-block-gap);
}

.avatar-btn {
  padding: 0;
  background: transparent;
  border: none;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 136rpx;
  height: 136rpx;
  border-radius: 68rpx;
  background: rgba(223, 238, 229, 0.8);
}

.avatar-tip {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #6b8578;
}

.form-item {
  margin-bottom: var(--space-block-gap);
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #3d5248;
}

.input,
.picker-value {
  min-height: 84rpx;
  padding: 0 24rpx;
  line-height: 84rpx;
  border-radius: 18rpx;
  background: #f5fbf7;
  border: 1rpx solid rgba(205, 225, 214, 0.9);
  color: #2f493e;
  font-size: 28rpx;
}

.save-btn {
  margin-top: 8rpx;
}

.account-card .info-row {
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(205, 225, 214, 0.6);
}

.account-card .info-row:last-child {
  border-bottom: none;
}

.info-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #6b8578;
}

.info-value {
  font-size: 26rpx;
  color: #3d5248;
  word-break: break-all;
}

.info-muted {
  font-size: 22rpx;
  color: #70867c;
}

.logout-card {
  padding: var(--space-card-padding);
  background: transparent;
  border: none;
  box-shadow: none;
}

.logout-btn {
  margin: 0;
  color: #4f5d6f;
  background: rgba(243, 246, 249, 0.98);
  border: 1rpx solid rgba(154, 168, 181, 0.45);
  border-radius: 22rpx;
}

.error-box {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #fdf2ef;
  color: #bb5a49;
  font-size: 26rpx;
}

.success-box {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(223, 238, 229, 0.95);
  color: #35624f;
  font-size: 26rpx;
}

