.detail-page {
  position: relative;
  min-height: 100vh;
  padding: 0 var(--space-page-x) 60rpx;
  box-sizing: border-box;
  background: #f8fafc;
}

/* 单题模式：整个页面固定容器 */
.single-fixed-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow-y: auto;
  overflow-x: hidden;
  background: #f8fafc;
  padding: 0 var(--space-page-x) 60rpx;
  box-sizing: border-box;
}

.single-card {
  margin-top: var(--space-block-gap);
}

/* ========== 靛蓝色 Hero 渐变 ========== */
.hero-card {
  background: linear-gradient(135deg, #4f46e5, #818cf8);
}

/* ========== 进度条（sticky吸附） ========== */
.progress-bar-container {
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 20rpx 30rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f1f5f9;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.progress-info {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.progress-text {
  font-size: 26rpx;
  color: #64748b;
}

.progress-percent {
  font-size: 26rpx;
  color: #0f766e;
  font-weight: 600;
}

.progress-track {
  height: 12rpx;
  background: #f1f5f9;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #0f766e, #2dd4bf);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.submit-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  background: rgba(15, 23, 42, 0.48);
}

.submit-overlay-inner {
  width: 100%;
  max-width: 560rpx;
  padding: 48rpx 36rpx 44rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 42, 0.18);
  text-align: center;
}

.submit-spinner {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto 28rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(20, 184, 166, 0.2);
  border-top-color: #14b8a6;
  animation: submit-spin 0.85s linear infinite;
}

@keyframes submit-spin {
  to {
    transform: rotate(360deg);
  }
}

.submit-overlay-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.4;
}

.submit-overlay-desc {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: #64748b;
}

.card {
  padding: var(--space-card-padding);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.04);
}

.demo-banner {
  margin-bottom: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.65) 0%, rgba(224, 242, 254, 0.9) 100%);
  border: 1rpx solid rgba(147, 197, 253, 0.55);
}

.demo-banner-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1e3a5f;
}

.demo-banner-text {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #475569;
}

.question-card {
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.question-transitioning {
  opacity: 0;
  transform: translateX(20rpx);
}

.question-number {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
}

.question-title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.7;
  color: #111827;
}

.option-item {
  margin-top: 14rpx;
  padding: var(--space-card-padding);
  border-radius: 18rpx;
  background: #f8fafc;
  border: 2rpx solid transparent;
}

.option-item-active {
  background: #ecfeff;
  border-color: #14b8a6;
}

.option-text {
  font-size: 26rpx;
  color: #374151;
}

.quick-fill-btn {
  margin-top: var(--space-block-gap);
  background: rgba(239, 246, 255, 0.95);
  color: #1d4ed8;
  border: 1rpx solid rgba(147, 197, 253, 0.8);
}

/* 导航按钮 */
.question-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-block-gap);
  padding-top: var(--space-block-gap);
  border-top: 1rpx solid #f1f5f9;
}

.nav-btn {
  min-width: 160rpx;
  margin: 0;
  font-size: 28rpx;
}

.nav-btn-primary {
  background: linear-gradient(135deg, #4f46e5, #818cf8);
  color: #ffffff;
}

.nav-btn-submit {
  min-width: 200rpx;
}

/* 题目全览 ghost 按钮 */
.nav-btn-overview {
  background: transparent;
  color: #4f46e5;
  border: 2rpx solid #4f46e5;
  min-width: 160rpx;
}

.nav-btn-overview::after {
  border: none;
}

/* 瀑布流返回按钮 */
.waterfall-return-btn {
  margin-bottom: var(--space-block-gap);
}

.waterfall-question {
  padding: var(--space-card-padding);
  margin-bottom: var(--space-block-gap);
  border-radius: 18rpx;
  background: #f8fafc;
  border: 1rpx solid #f1f5f9;
}

/* 瀑布流选项之间的分割效果 */
.waterfall-question .option-item {
  margin-top: 0;
  border-radius: 0;
  background: #ffffff;
  border: none;
  border-bottom: 1rpx solid #f1f5f9;
  padding: 24rpx 16rpx;
}

.waterfall-question .option-item:last-child {
  border-bottom: none;
}

.waterfall-question .option-item-active {
  background: #ecfeff;
  border-bottom-color: #14b8a6;
}

/* 瀑布流底部提交按钮 */
.waterfall-submit-btn {
  width: 100%;
  margin-top: var(--space-block-gap);
}

/* 题目指示点 */
.question-dots {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: center;
  max-width: 400rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e5e7eb;
  transition: all 0.2s ease;
}

.dot-active {
  background: #4f46e5;
  transform: scale(1.2);
}

.dot-answered {
  background: #818cf8;
}

.empty-text,
.error-box {
  padding: 36rpx 24rpx;
  border-radius: 20rpx;
  text-align: center;
  font-size: 28rpx;
}

.empty-text {
  background: #ffffff;
  color: #6b7280;
}

.error-box {
  background: #fef2f2;
  color: #dc2626;
}


