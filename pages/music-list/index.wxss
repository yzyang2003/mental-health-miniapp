.music-page {
  min-height: 100vh;
  padding: 0 var(--space-page-x) 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4fbf7 0%, #eef7f3 52%, #f8f4ee 100%);
}

/* Hero Card */
.hero-card {
  background: linear-gradient(135deg, #6eaa8a, #82b79a);
}

/* Mood Bar */
.mood-bar {
  display: flex;
  gap: 0;
  margin-top: var(--space-block-gap);
  background: rgba(255, 255, 255, 0.96);
  border-radius: 20rpx;
  border: 1rpx solid rgba(205, 225, 214, 0.8);
  overflow: hidden;
}

.mood-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0;
  background: transparent;
  border: none;
  border-right: 1rpx solid rgba(205, 225, 214, 0.5);
  transition: all 0.25s ease;
}

.mood-tab:last-child {
  border-right: none;
}

.mood-tab-active {
  border-color: transparent;
}

.mood-icon {
  font-size: 32rpx;
  margin-bottom: 6rpx;
}

.mood-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #5f746a;
  transition: color 0.25s ease;
}

.mood-tab-active .mood-name {
  color: #fff;
}

/* Skeleton */
.skeleton-wrap {
  margin-top: var(--space-block-gap);
}

.skeleton-card {
  display: flex;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.6);
}

.skeleton-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #e8f0ec;
  flex-shrink: 0;
}

.skeleton-body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 8rpx;
  background: #e8f0ec;
  margin-bottom: 16rpx;
}

.skeleton-line-title {
  width: 60%;
  height: 30rpx;
}

.skeleton-line-desc {
  width: 90%;
}

.skeleton-line-short {
  width: 40%;
}

.skeleton-shine {
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% { opacity: 1; }
  50% { opacity: 0.4; }
  100% { opacity: 1; }
}

/* Featured Card */
.featured-card {
  margin-top: var(--space-block-gap);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.8);
  box-shadow: 0 8rpx 28rpx rgba(61, 90, 74, 0.08);
  overflow: hidden;
  transition: transform 0.2s ease;
}

.featured-card:active {
  transform: scale(0.98);
}

.featured-cover-wrap {
  position: relative;
  width: 100%;
  height: 320rpx;
  background: #eef3f1;
}

.featured-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.featured-cover-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #e8f2ec, #f3f6fb);
  display: flex;
  align-items: center;
  justify-content: center;
}

.featured-cover-icon {
  font-size: 72rpx;
  opacity: 0.4;
}

.featured-play-btn {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: rgba(110, 170, 138, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(61, 90, 74, 0.25);
}

.featured-play-icon {
  font-size: 28rpx;
  color: #fff;
  margin-left: 4rpx;
}

.featured-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(239, 68, 68, 0.85);
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
}

.featured-info {
  padding: 24rpx;
}

.featured-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.featured-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
}

.featured-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.featured-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-weight: 600;
}

.featured-duration,
.featured-plays {
  font-size: 22rpx;
  color: #9ca3af;
}

/* Playlist List */
.playlist-list {
  margin-top: var(--space-block-gap);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.playlist-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.8);
  box-shadow: 0 6rpx 20rpx rgba(61, 90, 74, 0.05);
  transition: transform 0.2s ease;
}

.playlist-card:active {
  transform: scale(0.98);
}

.playlist-cover-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #eef3f1;
}

.playlist-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.playlist-cover-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #e8f2ec, #f3f6fb);
  display: flex;
  align-items: center;
  justify-content: center;
}

.playlist-cover-icon {
  font-size: 40rpx;
  opacity: 0.4;
}

.playlist-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.playlist-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.playlist-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.playlist-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.playlist-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.playlist-duration {
  font-size: 22rpx;
  color: #9ca3af;
}

.playlist-play-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: rgba(110, 170, 138, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.play-icon-small {
  font-size: 22rpx;
  color: #6eaa8a;
  margin-left: 3rpx;
}

/* Empty State */
.empty-state {
  padding: 100rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #374151;
}

.empty-hint {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #9ca3af;
}
