.music-page {
  min-height: 100vh;
  padding: 128rpx var(--space-page-x) 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4fbf7 0%, #eef7f3 52%, #f8f4ee 100%);
}

.hero-card {
  margin-bottom: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.75);
  box-shadow: 0 12rpx 30rpx rgba(61, 90, 74, 0.08);
}

.hero-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #2b4a3d;
}

.hero-subtitle {
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b7280;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.playlist-card {
  width: 48%;
  margin-bottom: 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.7);
  box-shadow: 0 12rpx 26rpx rgba(61, 90, 74, 0.08);
  overflow: hidden;
}

.cover-wrap {
  width: 100%;
  height: 200rpx;
  background: #eef3f1;
}

.cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #e8f2ec, #f3f6fb);
}

.card-body {
  padding: 18rpx 18rpx 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #6b7280;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.tips-card {
  margin-top: 8rpx;
  padding: var(--space-card-padding);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(205, 225, 214, 0.65);
}

.tips-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #2b4a3d;
  margin-bottom: 10rpx;
}

.tips-text {
  font-size: 22rpx;
  line-height: 1.65;
  color: #6b7280;
}
