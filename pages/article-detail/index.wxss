.detail-page {
  min-height: 100vh;
  padding: 128rpx var(--space-page-x);
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4fbf7 0%, #eef7f3 100%);
}

.detail-card {
  padding: var(--space-card-padding);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.85);
  box-shadow: 0 12rpx 30rpx rgba(61, 90, 74, 0.08);
}

.detail-cover {
  width: 100%;
  height: 320rpx;
  border-radius: 18rpx;
  background: #e5e7eb;
}

.detail-title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #2b4a3d;
}

.detail-summary {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #5f746a;
}

.article-body {
  margin-top: 8rpx;
}

.article-paragraph {
  margin-top: 28rpx;
  font-size: 28rpx;
  line-height: 1.95;
  color: #3d5248;
  text-indent: 2em;
}

.tag-list {
  margin-top: 16rpx;
}

.outline-card {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f3f8f5;
}

.outline-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #2b4a3d;
}

.outline-item {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #35624f;
}

.mini-tag {
  display: inline-block;
  margin-right: 12rpx;
  margin-bottom: 10rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(223, 238, 229, 0.95);
  color: #35624f;
  font-size: 22rpx;
}

.info-row {
  margin-top: 22rpx;
}

.info-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.info-value {
  font-size: 28rpx;
  color: #111827;
  word-break: break-all;
}

.url-value {
  color: #2563eb;
}

.mini-copy-btn {
  margin: 0;
}

.related-item {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  background: #f7faf8;
}

.related-title {
  font-size: 27rpx;
  color: #1f2937;
}

.related-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.empty-text,
.error-box {
  padding: 36rpx 24rpx;
  border-radius: 20rpx;
  text-align: center;
  font-size: 28rpx;
}

.empty-text {
  background: #ffffff;
  color: #6b7280;
}

.error-box {
  background: #fef2f2;
  color: #dc2626;
}

