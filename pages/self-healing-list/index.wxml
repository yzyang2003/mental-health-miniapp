<view class="healing-page">
  <minimal-back />

  <!-- Header -->
  <view class="hero-card" style="margin-top: {{capsuleTopPx}}px; padding-right: {{capsuleRightPx}}px;">
    <view class="hero-title">自我疗愈</view>
    <view class="hero-desc">跟随步骤完成一次小练习</view>
    <view class="hero-desc">给自己一点温柔的关怀</view>
    <view class="hero-deco">🧘</view>
  </view>

  <!-- Stats Card -->
  <view class="stats-card">
    <view class="stat-item">
      <view class="stat-number">{{completedCount}}</view>
      <view class="stat-label">已完成</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-number">{{streak}}</view>
      <view class="stat-label">连续天数</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item today {{todayCompleted ? 'completed' : ''}}">
      <view class="stat-icon">{{todayCompleted ? '✓' : '○'}}</view>
      <view class="stat-label">今日</view>
    </view>
  </view>

  <!-- Quick Actions -->
  <view class="quick-actions">
    <view class="action-btn recommend" bindtap="onRecommendTap">
      <view class="action-icon">🎲</view>
      <view class="action-text">随机推荐</view>
    </view>
    <view class="action-btn reminder" bindtap="toggleReminder">
      <view class="action-icon">⏰</view>
      <view class="action-text">设置提醒</view>
    </view>
  </view>

  <!-- Reminder Panel -->
  <view class="reminder-panel" wx:if="{{showReminder}}">
    <view class="reminder-content">
      <view class="reminder-title">每日练习提醒</view>
      <picker mode="time" value="{{reminderTime}}" bindchange="onReminderTimeChange">
        <view class="time-picker">
          <view class="time-label">提醒时间</view>
          <view class="time-value">{{reminderTime}} ▼</view>
        </view>
      </picker>
      <view class="reminder-actions">
        <view class="reminder-btn cancel" bindtap="toggleReminder">取消</view>
        <view class="reminder-btn confirm" bindtap="setReminder">确定</view>
      </view>
    </view>
  </view>

  <!-- Category Filter -->
  <view class="filter-card">
    <view class="section-title">问题类型</view>
    <scroll-view class="tag-scroll" scroll-x enable-flex>
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="tag-item {{selectedCategoryId === item.id ? 'tag-item-active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectCategory"
      >
        {{item.name}}
      </view>
    </scroll-view>
  </view>

  <!-- Exercise List -->
  <view class="list-card">
    <view class="list-header">
      <view class="section-title">练习列表</view>
      <view class="summary-text">共 {{filteredExercises.length}} 项</view>
    </view>

    <view wx:if="{{loading}}" class="exercise-list">
      <view wx:for="{{[1,2,3]}}" wx:key="*this" class="exercise-card">
        <view class="exercise-header"><view class="skeleton-tag skeleton-shine"></view></view>
        <view class="skeleton-title skeleton-shine"></view>
        <view class="skeleton-desc skeleton-shine"></view>
        <view class="skeleton-desc skeleton-desc-short skeleton-shine"></view>
      </view>
    </view>

    <view wx:elif="{{!filteredExercises.length}}" class="empty-box">
      <view class="empty-icon">🧘</view>
      <view class="empty-title">暂无练习</view>
      <view class="empty-desc">该分类下暂时没有练习，可先试试其他分类</view>
    </view>

    <view wx:elif="{{filteredExercises.length}}" class="exercise-list">
      <view
        wx:for="{{filteredExercises}}"
        wx:key="id"
        class="exercise-card {{item.completed ? 'completed' : ''}}"
        data-id="{{item.id}}"
        bindtap="openDetail"
      >
        <view class="exercise-header">
          <view class="exercise-category">{{item.categoryName}}</view>
          <view class="exercise-status" wx:if="{{item.completed}}">✓</view>
        </view>
        <view class="exercise-title">{{item.title}}</view>
        <view class="exercise-desc">{{item.shortDesc}}</view>
        <view class="exercise-meta">
          <view class="meta-item">
            <view class="meta-icon">⏱</view>
            <view class="meta-text">{{item.durationText}}</view>
          </view>
          <view class="meta-item">
            <view class="meta-icon">📋</view>
            <view class="meta-text">{{item.stepCount}} 步</view>
          </view>
        </view>
        <view class="exercise-hint">点击开始练习 →</view>
      </view>
    </view>
  </view>
</view>
