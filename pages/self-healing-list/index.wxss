.healing-page {
  min-height: 100vh;
  padding: 0 var(--space-page-x) 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4fbf7 0%, #eef7f3 52%, #f8f4ee 100%);
}

/* Hero Card */
.hero-card {
  background: linear-gradient(135deg, #82b79a, #a8d4b8);
}

/* Stats Card */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: var(--space-block-gap);
  padding: 32rpx var(--space-card-padding);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.9);
  box-shadow: 0 8rpx 24rpx rgba(61, 90, 74, 0.06);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 48rpx;
  font-weight: 700;
  color: #6eaa8a;
}

.stat-icon {
  font-size: 40rpx;
  color: #9ca3af;
}

.stat-item.today.completed .stat-icon {
  color: #6eaa8a;
}

.stat-label {
  font-size: 24rpx;
  color: #5f746a;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(205, 225, 214, 0.8);
}

/* Quick Actions */
.quick-actions {
  display: flex;
  gap: 16rpx;
  margin-top: var(--space-block-gap);
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.8);
  transition: transform 0.2s ease;
}

.action-btn:active {
  transform: scale(0.98);
}

.action-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.action-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #2b4a3d;
}

/* Reminder Panel */
.reminder-panel {
  margin-top: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.9);
  box-shadow: 0 8rpx 24rpx rgba(61, 90, 74, 0.06);
}

.reminder-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2b4a3d;
  margin-bottom: 24rpx;
  text-align: center;
}

.time-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(239, 247, 242, 0.9);
  border: 1rpx solid rgba(198, 223, 210, 0.75);
}

.time-label {
  font-size: 28rpx;
  color: #5f746a;
}

.time-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #2b4a3d;
}

.reminder-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.reminder-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.reminder-btn.cancel {
  background: rgba(239, 247, 242, 0.9);
  color: #5f746a;
}

.reminder-btn.confirm {
  background: linear-gradient(135deg, #6eaa8a, #82b79a);
  color: #ffffff;
}

/* Filter Card */
.filter-card {
  margin-top: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.9);
  box-shadow: 0 8rpx 24rpx rgba(61, 90, 74, 0.06);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2b4a3d;
  margin-bottom: 16rpx;
}

.tag-scroll {
  white-space: nowrap;
}

.tag-item {
  display: inline-block;
  padding: 14rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #5f746a;
  background: rgba(239, 247, 242, 0.9);
  border: 1rpx solid rgba(198, 223, 210, 0.75);
  transition: all 0.2s ease;
}

.tag-item-active {
  color: #ffffff;
  background: linear-gradient(135deg, #6eaa8a, #82b79a);
  border-color: transparent;
}

/* List Card */
.list-card {
  margin-top: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.9);
  box-shadow: 0 8rpx 24rpx rgba(61, 90, 74, 0.06);
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.summary-text {
  font-size: 24rpx;
  color: #6b7280;
}

/* Exercise List */
.exercise-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.exercise-card {
  padding: 24rpx;
  border-radius: 20rpx;
  background: rgba(239, 247, 242, 0.9);
  border: 1rpx solid rgba(198, 223, 210, 0.75);
  transition: transform 0.2s ease;
}

.exercise-card:active {
  transform: scale(0.98);
}

.exercise-card.completed {
  background: rgba(220, 252, 231, 0.5);
  border-color: rgba(134, 239, 172, 0.5);
}

.exercise-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.exercise-category {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(110, 170, 138, 0.12);
  color: #6eaa8a;
  font-weight: 600;
}

.exercise-status {
  font-size: 28rpx;
  color: #22c55e;
}

.exercise-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.exercise-desc {
  font-size: 26rpx;
  line-height: 1.6;
  color: #6b7280;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.exercise-meta {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
}

.meta-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #5f746a;
}

.exercise-hint {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(198, 223, 210, 0.6);
  font-size: 24rpx;
  color: #6eaa8a;
  text-align: right;
}

/* Empty State */
.empty-box {
  padding: 60rpx 24rpx;
  text-align: center;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #6b7280;
}

/* Skeleton */
.skeleton-tag {
  display: inline-block;
  width: 120rpx;
  height: 36rpx;
  border-radius: 12rpx;
  background: #e8f0ec;
}

.skeleton-title {
  width: 60%;
  height: 36rpx;
  border-radius: 8rpx;
  background: #e8f0ec;
  margin-bottom: 16rpx;
}

.skeleton-desc {
  width: 90%;
  height: 24rpx;
  border-radius: 8rpx;
  background: #e8f0ec;
  margin-bottom: 12rpx;
}

.skeleton-desc-short {
  width: 50%;
}

.skeleton-shine {
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% { opacity: 1; }
  50% { opacity: 0.4; }
  100% { opacity: 1; }
}
