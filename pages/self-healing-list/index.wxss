.healing-page {
  min-height: 100vh;
  padding: 128rpx var(--space-page-x) 40rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4fbf7 0%, #eef7f3 52%, #f8f4ee 100%);
}

.hero-card {
  margin-bottom: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.75);
  box-shadow: 0 12rpx 30rpx rgba(61, 90, 74, 0.08);
}

.hero-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #2b4a3d;
}

.hero-subtitle {
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.65;
  color: #6b7280;
}

.filter-card,
.list-card {
  margin-bottom: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.75);
  box-shadow: 0 12rpx 30rpx rgba(61, 90, 74, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2b4a3d;
}

.title-center {
  text-align: center;
}

.tag-scroll {
  margin-top: 20rpx;
  white-space: nowrap;
}

.tag-item {
  display: inline-block;
  padding: 12rpx 22rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: rgba(223, 238, 229, 0.95);
  color: #35624f;
  font-size: 24rpx;
}

.tag-item-active {
  background: linear-gradient(135deg, #6eaa8a, #82b79a);
  color: #ffffff;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.summary-text {
  font-size: 24rpx;
  color: #6b7280;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.exercise-card {
  width: 48%;
  margin-bottom: 22rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: #f7fbf9;
  border: 1rpx solid rgba(205, 225, 214, 0.7);
  box-sizing: border-box;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pill {
  max-width: 70%;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #35624f;
  background: rgba(223, 238, 229, 0.95);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.done-badge {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #166534;
  background: #dcfce7;
}

.card-title {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #6b7280;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 74rpx;
}

.card-footer {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
}

.meta-chip {
  margin-right: 10rpx;
  margin-top: 8rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #1f2937;
  background: #eef2f7;
}

.meta-chip.ghost {
  color: #35624f;
  background: rgba(223, 238, 229, 0.75);
}

.empty-box {
  padding: 36rpx 24rpx;
  border-radius: 18rpx;
  text-align: center;
  background: #f8fafc;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b7280;
}
