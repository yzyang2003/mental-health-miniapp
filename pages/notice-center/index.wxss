.notice-page {
  min-height: 100vh;
  padding: 0 var(--space-page-x) 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4fbf7 0%, #eef7f3 52%, #f8f4ee 100%);
}

/* 骨架屏 */
.skeleton-wrap {
  margin-top: var(--space-block-gap);
}

.skeleton-item {
  padding: var(--space-card-padding);
  border-radius: 24rpx;
  background: #ffffff;
  margin-bottom: var(--space-block-gap);
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.04);
}

.skeleton-line {
  height: 24rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeletonShimmer 1.5s infinite;
  margin-bottom: 16rpx;
}

.skeleton-line--title {
  width: 60%;
  height: 28rpx;
  margin-bottom: 20rpx;
}

.skeleton-line--short {
  width: 40%;
}

@keyframes skeletonShimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 通知卡片 */
.notice-item {
  margin-top: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.04);
  transition: transform 0.15s ease;
}

.notice-item:active {
  transform: scale(0.98);
}

.notice-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2b4a3d;
  margin-bottom: 10rpx;
}

.notice-content {
  font-size: 26rpx;
  line-height: 1.7;
  color: #4b5563;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.notice-time {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #6b7280;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 72rpx 24rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #6b7280;
}