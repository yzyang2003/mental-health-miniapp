.notice-page {
  min-height: 100vh;
  padding: 128rpx 24rpx;
  box-sizing: border-box;
  background: #f8fafc;
}

.hero-card {
  margin-bottom: 24rpx;
  padding: 34rpx 28rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #4f46e5, #818cf8);
  box-shadow: 0 10rpx 28rpx rgba(79, 70, 229, 0.14);
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.92);
}

.notice-card {
  margin-bottom: 20rpx;
  padding: 26rpx 22rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.04);
}

.notice-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.notice-content {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #4b5563;
}

.notice-time {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.notice-empty {
  padding: 48rpx 28rpx;
  border-radius: 22rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.04);
}

.notice-empty-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #6b7280;
}


