<view class="notice-page">
  <minimal-back />

  <!-- Hero卡片 -->
  <view class="hero-card" style="margin-top: {{capsuleTopPx}}px; padding-right: {{capsuleRightPx}}px;">
    <view class="hero-title">通知中心</view>
    <view class="hero-desc">查看系统通知与消息</view>
    <view class="hero-deco">🔔</view>
  </view>

  <!-- 加载骨架屏 -->
  <view wx:if="{{loading}}" class="skeleton-wrap">
    <view class="skeleton-item">
      <view class="skeleton-line skeleton-line--title"></view>
      <view class="skeleton-line"></view>
      <view class="skeleton-line skeleton-line--short"></view>
    </view>
    <view class="skeleton-item">
      <view class="skeleton-line skeleton-line--title"></view>
      <view class="skeleton-line"></view>
      <view class="skeleton-line skeleton-line--short"></view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && !notices.length}}" class="empty-state">
    <view class="empty-icon">📭</view>
    <view class="empty-text">暂无公告，后续通知将展示在这里。</view>
  </view>

  <!-- 通知列表 -->
  <view wx:if="{{!loading && notices.length}}" wx:for="{{notices}}" wx:key="id" class="notice-item">
    <view class="notice-title">{{item.title}}</view>
    <view class="notice-content">{{item.content}}</view>
    <view class="notice-time">{{item.createTime}}</view>
  </view>
</view>