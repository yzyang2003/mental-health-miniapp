.container {
  min-height: 100vh;
  padding: 0 var(--space-page-x) 360rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4fbf7 0%, #eef7f3 52%, #f8f4ee 100%);
}

.container-mine {
  /* 底部悬浮条 + 安全区，避免内容被遮挡（无 tabbar） */
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  /* 个人发帖历史：整体偏深绿灰，与「树洞广场」浅 mint 背景区分 */
  background: linear-gradient(180deg, #cfd9d2 0%, #b9c9bf 45%, #c8d5cc 100%);
}

/* 个人中心进入「我的发帖」：底部悬浮条（去树洞） */
.mine-float-bar {
  position: fixed;
  left: var(--space-page-x);
  right: var(--space-page-x);
  bottom: calc(12rpx + env(safe-area-inset-bottom));
  z-index: 70;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(28, 52, 46, 0.94);
  border: 1rpx solid rgba(45, 85, 72, 0.9);
  box-shadow:
    0 14rpx 36rpx rgba(12, 32, 26, 0.32),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(16rpx) saturate(1.1);
  -webkit-backdrop-filter: blur(16rpx) saturate(1.1);
}

.mine-float-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(220, 236, 228, 0.95);
}

.mine-float-action {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #ecfdf5;
  background: rgba(15, 118, 110, 0.55);
  border: 1rpx solid rgba(94, 234, 212, 0.42);
}

/* 我的发帖：头图区用深青绿，避免与广场页的亮 teal 渐变混淆 */
.container-mine .hero-card {
  background: linear-gradient(135deg, #042f2e 0%, #0f3d3a 40%, #134e4a 100%);
  border: 1rpx solid rgba(55, 120, 108, 0.55);
  box-shadow: 0 16rpx 40rpx rgba(4, 47, 46, 0.38);
}

.container-mine .hero-desc {
  color: rgba(204, 230, 220, 0.88);
}

.container-mine .card {
  background: rgba(228, 238, 232, 0.98);
  border-color: rgba(95, 125, 110, 0.5);
  box-shadow: 0 12rpx 30rpx rgba(22, 48, 38, 0.14);
}

.container-mine .section-title,
.container-mine .list-title {
  color: #132a22;
}

.container-mine .summary-text {
  color: #3d5348;
}

.container-mine .empty-text {
  color: #3d5348;
}

.container-mine .topic-item {
  background: rgba(210, 226, 216, 0.96);
  border-color: rgba(88, 118, 102, 0.48);
  box-shadow: 0 8rpx 22rpx rgba(18, 42, 32, 0.12);
}

.container-mine .topic-publisher {
  color: #0f241c;
}

.container-mine .topic-time {
  color: #4a6356;
}

.container-mine .reply-count-badge {
  color: #063d2f;
  background: rgba(148, 196, 168, 0.88);
  border-color: rgba(55, 95, 75, 0.45);
}

.container-mine .topic-content {
  color: #243d32;
}

.container-mine .content-toggle {
  color: #0a5c48;
}

.container-mine .topic-meta {
  color: #3d5348;
}

.container-mine .topic-action-detail {
  color: #0b5a46;
}

.card {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 28rpx;
  padding: var(--space-card-padding);
  border: 1rpx solid rgba(205, 225, 214, 0.85);
  box-shadow: 0 12rpx 30rpx rgba(61, 90, 74, 0.08);
}

.list-card {
  margin-bottom: var(--space-block-gap);
}

.hero-card {
  background: linear-gradient(135deg, #0d9488, #14b8a6);
}

.section-title {
  margin-bottom: 14rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #2b4a3d;
}

.floating-composer {
  position: fixed;
  left: var(--space-page-x);
  right: var(--space-page-x);
  bottom: calc(env(safe-area-inset-bottom) + 98rpx);
  z-index: 60;
  padding: var(--space-card-padding);
  border-radius: 24rpx;
  background:
    linear-gradient(168deg, rgba(255, 255, 255, 0.36) 0%, rgba(244, 251, 247, 0.2) 42%, rgba(232, 247, 238, 0.17) 100%),
    radial-gradient(120% 70% at 14% 2%, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 58%);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  box-shadow:
    0 18rpx 40rpx rgba(61, 90, 74, 0.09),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.41),
    inset 0 -1rpx 0 rgba(190, 219, 203, 0.21);
  backdrop-filter: blur(20rpx) saturate(1.28);
  -webkit-backdrop-filter: blur(20rpx) saturate(1.28);
}

.floating-notice {
  margin: 0 0 10rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(236, 253, 245, 0.96);
  border: 1rpx solid rgba(167, 243, 208, 0.72);
  color: #047857;
  font-size: 24rpx;
  line-height: 1.5;
}

.toolbar-icon-entry {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.image-count {
  display: none;
  text-align: right;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8aa097;
}

.topic-image-list-editor {
  margin: 0 0 10rpx;
  gap: 6rpx;
  flex-wrap: wrap;
  justify-content: flex-start;
}

.topic-image-item-editor {
  position: relative;
  width: calc(11.11% - 6rpx);
  aspect-ratio: 1;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.topic-image-list-editor .topic-image-item.topic-image-item-editor {
  width: calc(11.11% - 6rpx);
  aspect-ratio: 1;
  border-radius: 8rpx;
}

.topic-image-remove {
  position: absolute;
  right: -10rpx;
  top: -10rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.62);
  color: #fff;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.emoji-panel {
  margin: 12rpx 2rpx 4rpx;
  padding: 14rpx 14rpx 16rpx;
  border-radius: 16rpx;
  background: #f1f7f3;
  border: 1rpx solid rgba(200, 220, 209, 0.9);
}

.emoji-panel-title {
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: #6b8277;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.emoji-item {
  width: calc(11.11% - 8rpx);
  aspect-ratio: 1;
  border-radius: 10rpx;
  background: #fff;
  border: 1rpx solid rgba(198, 220, 208, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
}

.emoji-item-img {
  width: 75%;
  height: 75%;
}

.default-btn {
  margin-bottom: 20rpx;
}

.error-box {
  margin-top: 12rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #fef2f2;
  color: #dc2626;
  font-size: 26rpx;
  line-height: 1.6;
}

.success-box {
  margin-top: 12rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #ecfdf5;
  color: #059669;
  font-size: 26rpx;
  line-height: 1.6;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.list-title {
  margin-bottom: 0;
  text-align: left;
}

.summary-text {
  font-size: 20rpx;
  color: #6b7280;
}

.list-total-right {
  white-space: nowrap;
}

.empty-text {
  padding: 32rpx 0;
  text-align: center;
  color: #6b7280;
  font-size: 28rpx;
}

.topic-item {
  padding: 24rpx 22rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: rgba(239, 247, 242, 0.92);
  border: 1rpx solid rgba(198, 223, 210, 0.7);
  box-shadow: 0 8rpx 18rpx rgba(61, 90, 74, 0.06);
}

.topic-item:last-of-type {
  margin-bottom: 0;
}

.topic-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.topic-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.topic-publisher {
  font-size: 28rpx;
  font-weight: 600;
  color: #2b4a3d;
}

.topic-time {
  font-size: 21rpx;
  color: #95a8a0;
  flex-shrink: 0;
}

.reply-count-badge {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #2f7d5d;
  background: rgba(212, 240, 224, 0.95);
  border: 1rpx solid rgba(125, 188, 154, 0.5);
}

.topic-content {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.82;
  color: #40564b;
  white-space: pre-wrap;
  word-break: break-word;
}

.content-toggle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #2f7d5d;
  font-weight: 600;
}

.topic-image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.topic-image-item {
  border-radius: 16rpx;
  overflow: hidden;
  background: #e5e7eb;
}

.topic-image {
  width: 100%;
  height: 100%;
}

/* 九宫格布局：所有图片统一3列等宽正方形 */
.topic-image-list .topic-image-item {
  width: calc(33.33% - 8rpx);
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background: #e5e7eb;
}

.topic-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  gap: 16rpx;
}

.topic-meta {
  font-size: 23rpx;
  color: #7d9489;
}

.topic-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.topic-action-link {
  font-size: 24rpx;
  line-height: 1;
  font-weight: 500;
}

.topic-action-detail {
  color: #2f7d5d;
}

.topic-action-delete {
  color: #dc2626;
}


