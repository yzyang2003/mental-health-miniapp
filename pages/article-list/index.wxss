.article-page {
  min-height: 100vh;
  padding: 0 var(--space-page-x) calc(env(safe-area-inset-bottom) + 160rpx);
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4fbf7 0%, #eef7f3 52%, #f8f4ee 100%);
}

/* ===== 底部悬浮搜索栏（液态玻璃效果） ===== */
.floating-search {
  position: fixed;
  left: var(--space-page-x);
  right: var(--space-page-x);
  bottom: calc(env(safe-area-inset-bottom) + 12rpx);
  z-index: 60;
  padding: var(--space-card-padding, 15rpx);
  border-radius: 24rpx;
  background:
    linear-gradient(168deg, rgba(255, 255, 255, 0.36) 0%, rgba(244, 251, 247, 0.2) 42%, rgba(232, 247, 238, 0.17) 100%),
    radial-gradient(120% 70% at 14% 2%, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 58%);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  box-shadow:
    0 18rpx 40rpx rgba(61, 90, 74, 0.09),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.41),
    inset 0 -1rpx 0 rgba(190, 219, 203, 0.21);
  backdrop-filter: blur(20rpx) saturate(1.28);
  -webkit-backdrop-filter: blur(20rpx) saturate(1.28);
}

/* 历史搜索标签云面板 */
.search-history-panel {
  margin-bottom: 12rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(205, 225, 214, 0.7);
}

.search-history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.search-history-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #5f746a;
}

.search-history-clear {
  font-size: 20rpx;
  color: #9ca3af;
  padding: 4rpx 8rpx;
}

.search-history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.search-history-tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #5f746a;
  background: rgba(239, 247, 242, 0.9);
  border: 1rpx solid rgba(198, 223, 210, 0.6);
}

.search-history-tag:active {
  opacity: 0.7;
  background: rgba(110, 170, 138, 0.12);
}

.floating-search-inner {
  display: flex;
  align-items: center;
  padding: 12rpx 22rpx;
  height: 80rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.74) 0%, rgba(242, 250, 246, 0.74) 52%, rgba(236, 247, 240, 0.7) 100%),
    radial-gradient(110% 70% at 12% 0%, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0) 58%);
  border: 1rpx solid rgba(218, 236, 226, 0.9);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.65),
    inset 0 -1rpx 0 rgba(194, 219, 205, 0.28);
  backdrop-filter: blur(8rpx) saturate(1.08);
  -webkit-backdrop-filter: blur(8rpx) saturate(1.08);
}

.search-icon-small {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.floating-search-input {
  flex: 1;
  font-size: 28rpx;
  color: #2f493e;
}

.floating-search-placeholder {
  color: #97aaa2;
}

.floating-search-placeholder--right {
  text-align: right;
}

.floating-search-clear {
  font-size: 24rpx;
  color: #9ca3af;
  padding: 8rpx;
  flex-shrink: 0;
}

.floating-search-clear:active {
  opacity: 0.6;
}

/* 确认搜索按钮（树洞发送按钮风格） */
.floating-search-btn {
  margin-left: 12rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #10b981, #34d399);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
}

.floating-search-btn:active {
  transform: scale(0.92);
  opacity: 0.85;
}

.search-btn-arrow {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

/* 回到顶部按钮（与搜索按钮风格一致，绿色圆形 + 向上箭头） */
.floating-search-btn--top {
  background: linear-gradient(135deg, #10b981, #34d399);
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
}

/* ===== Hero 卡片 ===== */
.hero-card {
  background: linear-gradient(135deg, #0d9488, #2dd4bf);
}

/* ===== 星标图标（缩小版） ===== */
.star-icon {
  width: 32rpx;
  height: 32rpx;
}

/* ===== 统一筛选栏 ===== */
.filter-section {
  margin-top: var(--space-block-gap);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.category-scroll {
  white-space: nowrap;
}

.category-tab {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #5f746a;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.8);
  transition: all 0.25s ease;
}

.category-tab.active {
  color: #ffffff;
  background: linear-gradient(135deg, #6eaa8a, #82b79a);
  border-color: transparent;
}

.category-icon {
  margin-right: 6rpx;
  font-size: 24rpx;
}

.filter-chips {
  display: flex;
  gap: 12rpx;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #5f746a;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.8);
  transition: all 0.25s ease;
}

.filter-chip.active {
  background: rgba(110, 170, 138, 0.15);
  border-color: #6eaa8a;
  color: #6eaa8a;
}

.filter-chip:active {
  opacity: 0.7;
}

/* ===== 骨架屏 ===== */
.skeleton-list {
  margin-top: var(--space-block-gap);
}

.skeleton-card {
  margin-bottom: 24rpx;
  padding: var(--space-card-padding, 15rpx);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.5);
}

.skeleton-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.skeleton-tag {
  width: 120rpx;
  height: 40rpx;
  border-radius: 12rpx;
}

.skeleton-fav {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
}

.skeleton-title {
  width: 80%;
  height: 40rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.skeleton-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.skeleton-source {
  width: 200rpx;
  height: 32rpx;
  border-radius: 8rpx;
}

.skeleton-readtime {
  width: 100rpx;
  height: 32rpx;
  border-radius: 8rpx;
}

.skeleton-desc {
  width: 100%;
  height: 36rpx;
  border-radius: 8rpx;
}

.skeleton-shine {
  background: linear-gradient(90deg, rgba(229, 240, 234, 0.4) 25%, rgba(229, 240, 234, 0.8) 50%, rgba(229, 240, 234, 0.4) 75%);
  background-size: 400% 100%;
  animation: skeleton-shine 1.5s ease-in-out infinite;
}

@keyframes skeleton-shine {
  0% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ===== 列表过渡动效 ===== */
.article-list {
  margin-top: var(--space-block-gap);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.article-list.list-enter {
  opacity: 1;
  transform: translateY(0);
}

.article-list.list-exit {
  opacity: 0.3;
  transform: translateY(12rpx);
}

/* ===== 文章卡片 ===== */
.article-card {
  margin-bottom: 24rpx;
  padding: var(--space-card-padding, 15rpx);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.9);
  box-shadow: 0 8rpx 24rpx rgba(61, 90, 74, 0.06);
  transition: transform 0.2s ease;
}

.article-card:active {
  transform: scale(0.98);
}

.article-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.article-category {
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #6eaa8a;
  background: rgba(110, 170, 138, 0.12);
}

.article-favorite {
  padding: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.article-favorite:active {
  transform: scale(1.2);
  transition: transform 0.15s ease;
}

.article-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 16rpx;
}

.article-source {
  font-size: 24rpx;
  color: #5f746a;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.article-read-time {
  font-size: 22rpx;
  color: #6eaa8a;
  white-space: nowrap;
}

.article-summary {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6b7280;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.article-card-footer {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(205, 225, 214, 0.6);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.article-read-hint {
  font-size: 24rpx;
  color: #6eaa8a;
}

/* 更新时间 */
.article-update-time {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.update-time-icon {
  font-size: 20rpx;
}

.update-time-text {
  font-size: 20rpx;
  color: #9ca3af;
}

/* 时间戳（收藏/历史模式） */
.article-timestamp {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.timestamp-icon {
  font-size: 20rpx;
}

.timestamp-text {
  font-size: 22rpx;
  color: #9ca3af;
}

/* ===== 空状态 ===== */
.empty-state {
  padding: 80rpx 0;
  text-align: center;
}

.empty-illustration {
  position: relative;
  display: inline-block;
  margin-bottom: 32rpx;
}

.empty-emoji {
  font-size: 96rpx;
  line-height: 1;
}

/* 呼吸浮动动画 */
.empty-breathing {
  animation: breathing 3s ease-in-out infinite;
}

@keyframes breathing {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}

.empty-emoji-float {
  position: absolute;
  top: -8rpx;
  right: -24rpx;
  font-size: 48rpx;
  opacity: 0.5;
  animation: float-leaf 3s ease-in-out infinite;
}

@keyframes float-leaf {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-12rpx) rotate(15deg); }
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2b4a3d;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #9ca3af;
}

/* 淡入动效 */
.empty-fade-in {
  animation: fadeInUp 0.5s ease forwards;
}

.empty-fade-in-delay {
  animation: fadeInUp 0.5s ease 0.25s forwards;
  opacity: 0;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===== 底部提示 ===== */
.tips-text {
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
}