.station-page {
  min-height: 100vh;
  padding: 128rpx var(--space-page-x) 180rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4fbf7 0%, #eef7f3 52%, #f8f4ee 100%);
}

.hero-card {
  padding: var(--space-card-padding);
  border-radius: 28rpx;
  background: linear-gradient(135deg, #6eaa8a, #82b79a);
  box-shadow: 0 12rpx 34rpx rgba(61, 90, 74, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.92);
}

.section-card {
  margin-top: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.9);
  box-shadow: 0 12rpx 30rpx rgba(61, 90, 74, 0.08);
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #2b4a3d;
}

.module-item {
  margin-bottom: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 22rpx;
  background: rgba(239, 247, 242, 0.9);
  border: 1rpx solid rgba(198, 223, 210, 0.75);
}

.module-item:last-child {
  margin-bottom: 0;
}

.module-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2b4a3d;
}

.module-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #5f746a;
}

.module-action {
  margin-top: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #3d7a5c;
}

