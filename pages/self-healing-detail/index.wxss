.detail-page {
  min-height: 100vh;
  padding: 128rpx var(--space-page-x) 40rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4fbf7 0%, #eef7f3 52%, #f8f4ee 100%);
}

.detail-card,
.step-card {
  padding: var(--space-card-padding);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.75);
  box-shadow: 0 12rpx 30rpx rgba(61, 90, 74, 0.08);
}

.step-card {
  margin-top: var(--space-block-gap);
}

.detail-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2b4a3d;
}

.detail-meta {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
}

.meta-pill {
  margin-right: 12rpx;
  margin-top: 10rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #35624f;
  background: rgba(223, 238, 229, 0.95);
}

.meta-pill.ghost {
  color: #1f2937;
  background: #eef2f7;
}

.detail-desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.75;
  color: #4b5563;
}

.principle-card {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f7fbf9;
  border: 1rpx solid rgba(205, 225, 214, 0.65);
}

.principle-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.principle-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #2b4a3d;
}

.principle-toggle {
  font-size: 24rpx;
  color: #6eaa8a;
}

.principle-body {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: #4b5563;
}

.step-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.step-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2b4a3d;
}

.step-count {
  font-size: 22rpx;
  color: #6b7280;
}

.step-progress {
  margin-bottom: 16rpx;
}

.step-tabs {
  white-space: nowrap;
  margin-bottom: 18rpx;
}

.step-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: rgba(223, 238, 229, 0.95);
  color: #35624f;
  font-size: 24rpx;
  font-weight: 700;
}

.step-tab-active {
  background: linear-gradient(135deg, #6eaa8a, #82b79a);
  color: #ffffff;
}

.step-tab-done {
  box-shadow: inset 0 0 0 2rpx rgba(110, 170, 138, 0.55);
}

.step-item {
  margin-bottom: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 18rpx;
  background: #f8fafc;
}

.step-index {
  font-size: 22rpx;
  color: #6eaa8a;
}

.step-name {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.step-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: #4b5563;
}

.action-row {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.action-btn {
  flex: 1;
  margin: 0 6rpx 0 0;
  min-width: 0;
  padding-left: 6rpx;
  padding-right: 6rpx;
  font-size: 22rpx;
}

.action-btn:last-child {
  margin-right: 0;
}

.primary-strong {
  background: linear-gradient(135deg, #6eaa8a, #82b79a);
  color: #ffffff;
}

.completion-box {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #166534;
  background: #ecfdf5;
}

.error-box {
  padding: 36rpx 24rpx;
  border-radius: 20rpx;
  text-align: center;
  font-size: 28rpx;
  background: #fef2f2;
  color: #dc2626;
}
