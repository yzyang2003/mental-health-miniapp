.history-page {
  min-height: 100vh;
  padding: 0 var(--space-page-x) 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4fbf7 0%, #eef7f3 52%, #f8f4ee 100%);
}

/* 加载卡片 */
.loading-card {
  margin-top: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.85);
  box-shadow: 0 12rpx 30rpx rgba(61, 90, 74, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid rgba(15, 118, 110, 0.2);
  border-top-color: #0f766e;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #6b7280;
}

.history-more {
  color: #6eaa8a;
  font-weight: 600;
}

/* 历史卡片 */
.history-item {
  margin-top: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.04);
  transition: transform 0.15s ease;
}

.history-item:active {
  transform: scale(0.98);
}

.history-demo-badge {
  display: inline-block;
  margin-bottom: 10rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #1d4ed8;
  background: rgba(219, 234, 254, 0.95);
  border: 1rpx solid rgba(147, 197, 253, 0.75);
}

.history-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2b4a3d;
}

.history-score {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #3d7a5c;
}

.history-line {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: #3d5248;
}

.history-suggestions {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #4b5563;
}

.history-time {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #6b7280;
}

/* 加载中 */
.empty-card {
  margin-top: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(205, 225, 214, 0.85);
  box-shadow: 0 12rpx 30rpx rgba(61, 90, 74, 0.08);
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 72rpx 24rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #6b7280;
}

.empty-hint {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 错误提示 */
.error-box {
  padding: 20rpx;
  border-radius: 16rpx;
  background: #fef2f2;
  color: #dc2626;
  font-size: 26rpx;
}
