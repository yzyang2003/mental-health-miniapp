<view class="consult-page">
  <minimal-back />
  <view class="hero-card" style="margin-top: {{capsuleTopPx}}px; padding-right: {{capsuleRightPx}}px;">
    <view class="hero-title">咨询支持中心</view>
    <view class="hero-desc">倾听内心的声音</view>
    <view class="hero-desc">用科学与温暖，陪你走过每一段路</view>
    <view class="hero-deco">💚</view>
  </view>

  <!-- 心理测评模块 -->
  <view class="module-card module-card--{{modules[0].colorTheme}}" data-path="{{modules[0].path}}" bindtap="openModule">
    <view class="module-header">
      <view class="module-icon-wrap module-icon-wrap--{{modules[0].colorTheme}}">
        <text class="module-icon">{{modules[0].icon}}</text>
      </view>
      <view class="module-info">
        <view class="module-title">{{modules[0].title}}</view>
        <view class="module-desc">{{modules[0].desc}}</view>
      </view>
      <view class="module-label module-label--{{modules[0].colorTheme}}">更多 ›</view>
    </view>
    <view wx:if="{{quickListLoading}}" class="quick-entry-wrap" catchtap="noop">
      <view class="quick-entry-title">测评量表快捷入口</view>
      <skeleton
        items="{{[{titleWidth: '75%', descWidth: '90%'}, {titleWidth: '60%', descWidth: '80%'}]}}"
        showAvatar="{{false}}"
        showDesc="{{true}}"
        type="list"
      />
    </view>
    <view wx:elif="{{questionnaireQuickList.length}}" class="quick-entry-wrap" catchtap="noop">
      <view class="quick-entry-title">测评量表快捷入口</view>
      <view
        wx:for="{{questionnaireQuickList}}"
        wx:key="id"
        class="quick-entry-item"
        data-id="{{item.id}}"
        bindtap="openQuestionnaireQuickEntry"
      >
        <view class="quick-entry-item-title">{{item.title}}</view>
        <view wx:if="{{item.coreNote}}" class="quick-entry-item-note">{{item.coreNote}}</view>
      </view>
    </view>
  </view>

  <!-- AI咨询模块 -->
  <view class="module-card module-card--{{modules[1].colorTheme}}" data-path="{{modules[1].path}}" bindtap="openModule">
    <view class="module-header">
      <view class="module-icon-wrap module-icon-wrap--{{modules[1].colorTheme}}">
        <text class="module-icon">{{modules[1].icon}}</text>
      </view>
      <view class="module-info">
        <view class="module-title">{{modules[1].title}}</view>
        <view class="module-desc">{{modules[1].desc}}</view>
      </view>
      <view class="module-label module-label--{{modules[1].colorTheme}}">开始 ›</view>
    </view>
    <view wx:if="{{chatSummary}}" class="chat-summary-wrap" catchtap="noop">
      <view class="chat-summary-label">最近对话</view>
      <view class="chat-summary-content">{{chatSummary}}</view>
    </view>
  </view>

  <bottom-nav current="consult"></bottom-nav>
</view>
