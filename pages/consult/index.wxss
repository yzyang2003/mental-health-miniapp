.consult-page {
  height: 100vh;
  overflow: hidden;
  padding: 0 var(--space-page-x);
  box-sizing: border-box;
  background: linear-gradient(180deg, #eff6ff 0%, #f8fafc 40%, #f8fafc 100%);
}

.hero-card {
  background: linear-gradient(135deg, #0f766e, #2dd4bf);
}

/* 模块卡片基础样式 */
.module-card {
  margin-top: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.04);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

/* 卡片悬停态 */
.module-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
}

/* 蓝色主题（测评） */
.module-card--blue {
  background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
  border: 1rpx solid rgba(59, 130, 246, 0.15);
}

/* 紫色主题（咨询） */
.module-card--purple {
  background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%);
  border: 1rpx solid rgba(147, 51, 234, 0.15);
}

/* 模块头部 */
.module-header {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

/* 图标背景圆 */
.module-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.module-icon-wrap--blue {
  background: rgba(59, 130, 246, 0.1);
}

.module-icon-wrap--purple {
  background: transparent;
}

.module-icon {
  font-size: 48rpx;
  line-height: 1;
}

.module-info {
  flex: 1;
}

.module-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.module-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #6b7280;
}

/* 标题右侧标签 */
.module-label {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.module-label--blue {
  color: #3b82f6;
  background: rgba(59, 130, 246, 0.1);
}

.module-label--purple {
  color: #8b5cf6;
  background: rgba(139, 92, 246, 0.1);
}

/* 快捷入口 */
.quick-entry-wrap {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(15, 118, 110, 0.12);
}

.quick-entry-title {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #6b7280;
}

.quick-entry-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.2);
}

.quick-entry-item:last-child {
  border-bottom: 0;
}

.quick-entry-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f766e;
}

.quick-entry-item-note {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #64748b;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 聊天摘要 */
.chat-summary-wrap {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(139, 92, 246, 0.12);
}

.chat-summary-label {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #6b7280;
}

.chat-summary-content {
  font-size: 26rpx;
  line-height: 1.6;
  color: #4b5563;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 保留旧的section-card样式（备用） */
.section-card {
  margin-top: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.04);
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}
