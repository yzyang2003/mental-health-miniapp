.consult-page {
  min-height: 100vh;
  padding: 128rpx var(--space-page-x) 180rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eff6ff 0%, #f8fafc 40%, #f8fafc 100%);
}

.hero-card {
  padding: var(--space-card-padding);
  border-radius: 28rpx;
  background: linear-gradient(135deg, #0f766e, #2dd4bf);
  box-shadow: 0 12rpx 34rpx rgba(15, 118, 110, 0.16);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.92);
}

.section-card {
  margin-top: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.04);
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.module-item {
  margin-bottom: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 22rpx;
  background: #f0fdfa;
}

.module-item:last-child {
  margin-bottom: 0;
}

.module-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.module-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6b7280;
}

.quick-entry-wrap {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(15, 118, 110, 0.12);
}

.quick-entry-title {
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.quick-entry-item {
  padding: 10rpx 0 12rpx;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.2);
}

.quick-entry-item-title {
  font-size: 26rpx;
  line-height: 1.55;
  font-weight: 600;
  color: #0f766e;
}

.quick-entry-item-note {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #64748b;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.quick-entry-item:last-child {
  border-bottom: 0;
}

.module-action {
  margin-top: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #0f766e;
}

