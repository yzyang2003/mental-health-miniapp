.container {
  min-height: 100vh;
  padding: 128rpx 28rpx 64rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4fbf7 0%, #eef7f3 52%, #f8f4ee 100%);
}

.card {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(205, 225, 214, 0.85);
  box-shadow: 0 12rpx 30rpx rgba(61, 90, 74, 0.08);
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #2b4a3d;
}

.topic-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.topic-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.topic-publisher {
  font-size: 28rpx;
  font-weight: 600;
  color: #2b4a3d;
}

.topic-time {
  font-size: 21rpx;
  color: #95a8a0;
}

.reply-count-badge {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #2f7d5d;
  background: rgba(212, 240, 224, 0.95);
  border: 1rpx solid rgba(125, 188, 154, 0.5);
}

.topic-content {
  margin-top: 16rpx;
  font-size: 29rpx;
  line-height: 1.75;
  color: #3d5248;
  white-space: pre-wrap;
  word-break: break-word;
}

.topic-image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.topic-image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: rgba(223, 238, 229, 0.6);
}

.topic-image {
  width: 100%;
  height: 100%;
}

.topic-meta {
  font-size: 24rpx;
  color: #6b8578;
}

.topic-delete-link {
  font-size: 24rpx;
  color: #d14a4a;
}

.topic-action-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.topic-action-link {
  font-size: 24rpx;
}

.topic-reply-link {
  color: #2f7d5d;
}

.topic-footer {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.reply-item {
  position: relative;
  padding: 14rpx 14rpx;
  margin-bottom: 10rpx;
  border-radius: 16rpx;
  background: rgba(241, 248, 244, 0.82);
  border: 1rpx solid rgba(198, 223, 210, 0.55);
}

.reply-item-nested {
  padding-left: 18rpx;
  background: rgba(244, 250, 247, 0.78);
  border-color: rgba(188, 218, 201, 0.62);
}

.reply-thread-rail {
  position: absolute;
  top: 10rpx;
  bottom: 10rpx;
  left: 7rpx;
  width: 3rpx;
  border-radius: 2rpx;
  background: linear-gradient(180deg, rgba(99, 167, 133, 0.65), rgba(130, 188, 158, 0.4));
}

.reply-item:last-of-type {
  margin-bottom: 0;
}

.reply-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.reply-author {
  font-size: 25rpx;
  font-weight: 600;
  color: #35624f;
}

.reply-time {
  font-size: 20rpx;
  color: #9caea6;
}

.reply-content {
  margin-top: 6rpx;
  font-size: 27rpx;
  line-height: 1.66;
  color: #3d5248;
  white-space: pre-wrap;
  word-break: break-word;
}

.content-toggle {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #2f7d5d;
  font-weight: 600;
}

.reply-thread-toggle {
  display: inline-block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #4b6f5f;
}

.reply-actions {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.reply-action-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.reply-action-link {
  font-size: 23rpx;
  line-height: 1.25;
}

.reply-action-thread {
  color: #4b6f5f;
}

.reply-action-reply {
  color: #2f7d5d;
}

.reply-action-delete {
  color: #d14a4a;
}

.reply-target-cancel {
  color: #0f766e;
  font-weight: 600;
}

.floating-composer {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  z-index: 100;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background:
    linear-gradient(168deg, rgba(255, 255, 255, 0.36) 0%, rgba(244, 251, 247, 0.2) 42%, rgba(232, 247, 238, 0.17) 100%),
    radial-gradient(120% 70% at 14% 2%, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 58%);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  box-shadow:
    0 18rpx 40rpx rgba(61, 90, 74, 0.09),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.41),
    inset 0 -1rpx 0 rgba(190, 219, 203, 0.21);
  backdrop-filter: blur(20rpx) saturate(1.28);
  -webkit-backdrop-filter: blur(20rpx) saturate(1.28);
}

.reply-composer-body {
  position: relative;
  min-height: 128rpx;
}

.reply-composer-input {
  width: 100%;
  min-height: 128rpx;
  max-height: 180rpx;
  margin-right: 0;
  padding: 12rpx 74rpx 12rpx 14rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(205, 225, 214, 0.9);
  background: #f5fbf7;
  font-size: 26rpx;
  line-height: 1.55;
  color: #2f493e;
  box-sizing: border-box;
}

.reply-composer-placeholder {
  color: #8ea49a;
  font-style: italic;
}

.reply-send-btn {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  top: auto;
  width: 52rpx;
  margin: 0;
  min-width: 52rpx;
  max-width: 52rpx;
  height: 52rpx;
  min-height: 52rpx;
  max-height: 52rpx;
  line-height: 1.2;
  padding: 0;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #55b285, #469c73);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(77, 151, 116, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
}

.reply-send-btn-disabled {
  opacity: 0.55;
}

.empty-text {
  padding: 24rpx 0;
  text-align: center;
  color: #6b8578;
  font-size: 28rpx;
}

.error-box {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #fdf2ef;
  color: #bb5a49;
  font-size: 26rpx;
  line-height: 1.6;
}

.success-box {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(223, 238, 229, 0.95);
  color: #35624f;
  font-size: 26rpx;
  line-height: 1.6;
}

.topic-textarea {
  width: 100%;
  min-height: 112rpx;
  padding: 12rpx 22rpx;
  margin-bottom: 0;
  border-radius: 20rpx;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.74) 0%, rgba(242, 250, 246, 0.74) 52%, rgba(236, 247, 240, 0.7) 100%),
    radial-gradient(110% 70% at 12% 0%, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0) 58%);
  border: 1rpx solid rgba(218, 236, 226, 0.9);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.65),
    inset 0 -1rpx 0 rgba(194, 219, 205, 0.28);
  backdrop-filter: blur(8rpx) saturate(1.08);
  -webkit-backdrop-filter: blur(8rpx) saturate(1.08);
  color: #2f493e;
  font-size: 28rpx;
  line-height: 44rpx;
  box-sizing: border-box;
}

.topic-placeholder {
  color: #97aaa2;
}

.topic-toolbar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 10rpx;
  padding: 10rpx 0rpx;
  background: rgba(245, 251, 247, 0.08);
  border: 0;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.toolbar-mode-toggle {
  height: 42rpx;
  line-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.75);
  border: 1rpx solid rgba(166, 184, 173, 0.65);
  color: #587164;
  font-size: 25rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.toolbar-mode-toggle-active {
  background: rgba(21, 196, 101, 0.12);
  border-color: rgba(18, 194, 100, 0.48);
  color: #0f8f4b;
}

.topic-toolbar-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  margin-left: auto;
  min-width: 0;
  flex: 1;
}

.toolbar-publish-btn {
  box-sizing: border-box;
  height: 42rpx;
  width: 42rpx;
  line-height: 42rpx;
  border-radius: 999rpx;
  background: #12c264;
  color: #fff;
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.toolbar-btn-disabled {
  opacity: 0.6;
}


