.container {
  min-height: 100vh;
  padding: 128rpx 28rpx 200rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4fbf7 0%, #eef7f3 52%, #f8f4ee 100%);
}

.card {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(205, 225, 214, 0.85);
  box-shadow: 0 12rpx 30rpx rgba(61, 90, 74, 0.08);
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #2b4a3d;
}

.topic-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.topic-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.topic-publisher {
  font-size: 28rpx;
  font-weight: 600;
  color: #2b4a3d;
}

.topic-time {
  font-size: 21rpx;
  color: #95a8a0;
}

.reply-count-badge {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #2f7d5d;
  background: rgba(212, 240, 224, 0.95);
  border: 1rpx solid rgba(125, 188, 154, 0.5);
}

.topic-content {
  margin-top: 16rpx;
  font-size: 29rpx;
  line-height: 1.75;
  color: #3d5248;
  white-space: pre-wrap;
  word-break: break-word;
}

.topic-image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.topic-image-item {
  border-radius: 20rpx;
  overflow: hidden;
  background: rgba(223, 238, 229, 0.6);
}

.topic-image {
  width: 100%;
  height: 100%;
}

/* 九宫格布局：所有图片统一3列等宽正方形 */
.topic-image-list .topic-image-item {
  width: calc(33.33% - 8rpx);
  aspect-ratio: 1;
}

.topic-meta {
  font-size: 24rpx;
  color: #6b8578;
}

.topic-delete-link {
  font-size: 24rpx;
  color: #d14a4a;
}

.topic-action-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.topic-action-link {
  font-size: 24rpx;
}

.topic-reply-link {
  color: #2f7d5d;
}

.topic-footer {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.reply-item {
  position: relative;
  padding: 14rpx 14rpx;
  margin-bottom: 10rpx;
  border-radius: 16rpx;
  background: rgba(241, 248, 244, 0.82);
  border: 1rpx solid rgba(198, 223, 210, 0.55);
}

.reply-item-nested {
  padding-left: 18rpx;
  background: rgba(244, 250, 247, 0.78);
  border-color: rgba(188, 218, 201, 0.62);
}

.reply-thread-rail {
  position: absolute;
  top: 10rpx;
  bottom: 10rpx;
  left: 7rpx;
  width: 3rpx;
  border-radius: 2rpx;
  background: linear-gradient(180deg, rgba(99, 167, 133, 0.65), rgba(130, 188, 158, 0.4));
}

.reply-item:last-of-type {
  margin-bottom: 0;
}

.reply-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.reply-author {
  font-size: 25rpx;
  font-weight: 600;
  color: #35624f;
}

.reply-time {
  font-size: 20rpx;
  color: #9caea6;
}

.reply-content {
  margin-top: 6rpx;
  font-size: 27rpx;
  line-height: 1.66;
  color: #3d5248;
  white-space: pre-wrap;
  word-break: break-word;
}

.content-toggle {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #2f7d5d;
  font-weight: 600;
}

.reply-thread-toggle {
  display: inline-block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #4b6f5f;
}

.reply-actions {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.reply-action-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.reply-action-link {
  font-size: 23rpx;
  line-height: 1.25;
}

.reply-action-reply {
  color: #2f7d5d;
}

.reply-action-delete {
  color: #d14a4a;
}

.reply-target-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 14rpx;
  margin-bottom: 10rpx;
  border-radius: 12rpx;
  background: rgba(220, 245, 232, 0.92);
  border: 1rpx solid rgba(134, 206, 172, 0.55);
}

.reply-target-text {
  font-size: 24rpx;
  color: #2f7d5d;
  font-weight: 500;
}

.reply-target-cancel {
  font-size: 24rpx;
  color: #d14a4a;
  font-weight: 600;
  padding: 4rpx 12rpx;
}

.empty-text {
  padding: 24rpx 0;
  text-align: center;
  color: #6b8578;
  font-size: 28rpx;
}

.error-box {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #fdf2ef;
  color: #bb5a49;
  font-size: 26rpx;
  line-height: 1.6;
}

.success-box {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(223, 238, 229, 0.95);
  color: #35624f;
  font-size: 26rpx;
  line-height: 1.6;
}

.load-more-replies-btn {
  margin-top: 16rpx;
  margin-bottom: 8rpx;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: rgba(223, 238, 229, 0.6);
  border: 1rpx solid rgba(134, 206, 172, 0.5);
  color: #2f7d5d;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.4;
}
.load-more-replies-btn::after {
  border: none;
}

.floating-composer {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: 24rpx;
  z-index: 100;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background:
    linear-gradient(168deg, rgba(255, 255, 255, 0.36) 0%, rgba(244, 251, 247, 0.2) 42%, rgba(232, 247, 238, 0.17) 100%),
    radial-gradient(120% 70% at 14% 2%, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 58%);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  box-shadow:
    0 18rpx 40rpx rgba(61, 90, 74, 0.09),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.41),
    inset 0 -1rpx 0 rgba(190, 219, 203, 0.21);
  backdrop-filter: blur(20rpx) saturate(1.28);
  -webkit-backdrop-filter: blur(20rpx) saturate(1.28);
}