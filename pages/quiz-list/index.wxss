.quiz-page {
  min-height: 100vh;
  padding: 0 var(--space-page-x) 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4fbf7 0%, #eef7f3 52%, #f8f4ee 100%);
}

.hero-card {
  background: linear-gradient(135deg, #4f46e5, #818cf8);
}

.card {
  margin-bottom: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.04);
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  text-align: center;
}

.quiz-item,
.history-item {
  margin-bottom: var(--space-block-gap);
  padding: var(--space-card-padding);
  border-radius: 20rpx;
  background: #f8fafc;
}

.quiz-item:last-child,
.history-item:last-child {
  margin-bottom: 0;
}

.quiz-cover {
  width: 100%;
  height: 240rpx;
  border-radius: 18rpx;
  background: #e5e7eb;
}

.quiz-title,
.history-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.quiz-desc,
.history-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #4b5563;
}

.quiz-meta,
.history-time {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.quiz-footer {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.quiz-action {
  font-size: 24rpx;
  font-weight: 600;
  color: #0f766e;
}

.empty-text {
  padding: 32rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #6b7280;
}

.empty-hint .empty-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #9ca3af;
}

.empty-hint .mono {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  word-break: break-all;
}

.quiz-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #1d4ed8;
  background: rgba(219, 234, 254, 0.95);
  border: 1rpx solid rgba(147, 197, 253, 0.8);
}

.error-box {
  padding: 20rpx;
  border-radius: 16rpx;
  background: #fef2f2;
  color: #dc2626;
  font-size: 26rpx;
}

.error-box-page {
  margin-bottom: 20rpx;
  white-space: pre-wrap;
  word-break: break-word;
  line-height: 1.55;
}


