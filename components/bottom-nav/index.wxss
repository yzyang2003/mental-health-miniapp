.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: space-around;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  z-index: 999;
}

.bottom-nav-ios {
  background:
    linear-gradient(168deg, rgba(255, 255, 255, 0.36) 0%, rgba(244, 251, 247, 0.2) 42%, rgba(232, 247, 238, 0.17) 100%),
    radial-gradient(120% 70% at 14% 2%, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 58%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.35);
  box-shadow:
    0 -12rpx 30rpx rgba(61, 90, 74, 0.09),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.41),
    inset 0 -1rpx 0 rgba(190, 219, 203, 0.21);
  backdrop-filter: blur(20rpx) saturate(1.28);
  -webkit-backdrop-filter: blur(20rpx) saturate(1.28);
}

.bottom-nav-android {
  background: rgba(250, 253, 251, 0.98);
  border-top: 1rpx solid rgba(205, 225, 214, 0.72);
  box-shadow: 0 -8rpx 22rpx rgba(61, 90, 74, 0.07);
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  min-width: 96rpx;
  color: #6b7280;
}

.nav-item-active {
  color: #2563eb;
}

.nav-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: #cbd5e1;
}

.nav-dot-active {
  background: #2563eb;
}

.nav-label {
  font-size: 24rpx;
  font-weight: 600;
}
