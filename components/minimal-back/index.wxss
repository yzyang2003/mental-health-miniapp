.minimal-back {
  position: fixed;
  background: rgba(255, 255, 255, 0.98);
  border: 1px solid rgba(0, 0, 0, 0.12);
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1200;
}

.minimal-back-icon {
  margin-left: -1px;
  line-height: 1;
  color: #111827;
  font-weight: 400;
}
